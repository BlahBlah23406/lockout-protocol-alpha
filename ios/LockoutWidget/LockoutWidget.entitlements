<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget only reads the session file, so it needs the App Group but NOT family-controls - it never touches a token. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lockoutprotocol.lockout</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.com.lockoutprotocol.lockout</string>
	</array>

</dict>
</plist>
