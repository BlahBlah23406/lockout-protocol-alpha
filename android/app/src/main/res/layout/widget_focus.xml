<?xml version="1.0" encoding="utf-8"?>
<!--
  The focus widget. Laid out for a 4x1 home-screen cell: a coloured status bar down the left (the
  LCARS pill, and the at-a-glance "is it watching me" signal), then state, task, and detail.

  Everything is a plain View/TextView because RemoteViews only supports a fixed widget set — no
  custom views, no theme attributes, so the palette is set from code in FocusWidget.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <View
        android:id="@+id/widget_bar"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="#CC88CC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO SESSION"
            android:textColor="#CC88CC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What are you working on?"
            android:textColor="#FFCC66"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nothing is being watched"
            android:textColor="#9AE6C9"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="START A SESSION"
        android:textColor="#FF9966"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxWidth="90dp" />
</LinearLayout>
