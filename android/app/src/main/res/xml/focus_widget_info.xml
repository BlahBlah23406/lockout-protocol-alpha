<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose. The system's minimum is 30 minutes, which is useless for a
  live countdown, and asking for it anyway would just wake the device for no benefit. The widget is
  instead repainted by FocusWidget.refresh() whenever something actually changes — a session
  starting or ending, and each completed check.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_focus"
    android:previewLayout="@layout/widget_focus"
    android:resizeMode="horizontal"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
